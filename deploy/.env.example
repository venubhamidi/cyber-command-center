# Every setting the application reads. Copy to deploy/.env and edit. Never commit deploy/.env.
# scripts/check_structure.py fails the build if a setting is missing from this file.

# ---- which application this repository holds (the Python package name) ----
APP_PACKAGE=ccc

# ---- local docker compose only ----
POSTGRES_PASSWORD=change-me-locally
WEB_PORT=8080

# ---- runtime ----
# dev | test | prod. "prod" refuses static development tokens.
APP_ENVIRONMENT=dev
# Set automatically by docker compose. Outside compose: postgresql://user:password@host:5432/dbname
# APP_DATABASE_URL=
# Extra plugin modules to load, as a JSON list, e.g. ["ccc.plugins.my_connector"]
# APP_PLUGIN_MODULES=[]

# ---- login (plugin kind "auth") ----
# static = fixed development tokens (APP_API_TOKENS or the application's defaults). oidc = single sign-on.
APP_AUTH_PROVIDER=static
# APP_API_TOKENS={"some-token": ["user@example.com", "viewer"]}
# APP_OIDC_ISSUER=https://login.example.com/tenant-id/v2.0
# APP_OIDC_AUDIENCE=api://my-application
# APP_OIDC_JWKS_URL=https://login.example.com/tenant-id/discovery/v2.0/keys
# APP_OIDC_JWKS_JSON=
# APP_OIDC_ALGORITHMS=["RS256"]
# APP_OIDC_SUBJECT_CLAIM=sub
# APP_OIDC_ROLES_CLAIM=roles
# APP_OIDC_ROLE_MAP={"IdP-Group-Name": "viewer"}

# ---- API protection ----
APP_RATE_LIMIT_PER_MINUTE=120
# APP_CORS_ORIGINS=[]

# ---- model (plugin kind "llm") ----
# mock = offline stand-in. anthropic needs APP_LLM_MODEL and the ANTHROPIC_API_KEY secret.
APP_LLM_PROVIDER=mock
# APP_LLM_MODEL=
# APP_LLM_TIMEOUT_S=60
# ANTHROPIC_API_KEY=

# ---- guardrails ----
# Values replaced with placeholders before text reaches a model: email, ipv4, mac, us_ssn
# Command Center default: ["ipv4","mac","email"]
# APP_REDACT_PATTERNS=["ipv4","mac","email"]

# ---- secrets (plugin kind "secrets") ----
# env = environment variables. file = one file per secret in APP_SECRETS_DIR.
APP_SECRETS_PROVIDER=env
# APP_SECRETS_DIR=/run/secrets

# ---- ticketing (plugin kind "ticketing") ----
# none | memory | servicenow. The Command Center MVP is read-only (PRD §12): none.
APP_TICKETING_PROVIDER=none
# APP_SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# APP_SERVICENOW_USER=
# APP_SERVICENOW_TABLE=incident
# SERVICENOW_PASSWORD=
